# AI Engineering Lab — copy to .env and fill in. Never commit .env.
# Every module works offline when no key is set.

# DeepSeek (OpenAI-compatible, https://api.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-flash

# Groq (OpenAI-compatible, https://api.groq.com/openai/v1)
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Which configured provider modules use by default: deepseek | groq
LAB_DEFAULT_PROVIDER=deepseek

# Force offline mode even if keys exist (1 = never call a paid API)
LAB_OFFLINE=0

# Tracing: store prompt/completion text in traces (0 = store only length + hash)
LAB_CAPTURE_CONTENT=0
LAB_TRACE_RETENTION_DAYS=14

# Network behaviour
LAB_HTTP_TIMEOUT_S=60
LAB_MAX_RETRIES=2

# Embeddings for RAG / caching: minilm (sentence-transformers, local) | hash (no download)
LAB_EMBEDDER=minilm

# Fine-tuning device: cpu (default, predictable memory) | mps | cuda
LAB_TORCH_DEVICE=cpu
